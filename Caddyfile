# Disable HTTP/3 (it runs over UDP, and only TCP 443 is open in the
# security group) — stick to HTTP/1.1 and HTTP/2, both plain TCP.
# default_sni tells Caddy which certificate to serve when a client
# connects by raw IP and doesn't send an SNI hint (common — curl and
# some browsers skip SNI for IP-literal addresses).
{
    servers {
        protocols h1 h2
        default_sni 10.2.1.185
    }
}

https://10.2.1.185 {
    tls internal
    reverse_proxy soi-tracker:4000
}
